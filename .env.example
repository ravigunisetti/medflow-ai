# ==============================================================================
# PHC-NET AI Configuration Environment Template
# ==============================================================================

# Application Profile
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phcnet_db
DB_USERNAME=phcadmin
DB_PASSWORD=phc_secure_password_change_me
DB_MAX_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ML Service (FastAPI)
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# Backend Service URL (for ML Service tools callback)
BACKEND_SERVICE_URL=http://localhost:8080

# Google Gemini API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Platform (Optional for local dev, Required for Cloud deploy)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GCP_PUBSUB_TOPIC_INVENTORY=phc-inventory-updates
GCP_PUBSUB_TOPIC_ALERTS=phc-alerts
GCP_BIGQUERY_DATASET=phc_analytics

# JWT & Security Configuration
JWT_SECRET=super_secret_jwt_signing_key_at_least_256_bits_length_12345
JWT_EXPIRATION_HOURS=24

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_ML_API_BASE_URL=http://localhost:8000/api/v1
